# 背景
background = #111111

# フォントサイズ
font-size = 14

# ANSI
palette = 1=#CC0000
palette = 2=#00A600

# 分割線
split-divider-color = #444444


# ========================================
# Ghostty Leader
# Ctrl+Space + key
# ========================================

# ペイン移動
keybind = ctrl+space>h=goto_split:left
keybind = ctrl+space>j=goto_split:down
keybind = ctrl+space>k=goto_split:up
keybind = ctrl+space>l=goto_split:right

# タブ移動
keybind = ctrl+space>shift+h=previous_tab
keybind = ctrl+space>shift+l=next_tab

# ペイン・タブを閉じる
keybind = ctrl+space>w=close_surface

# 水平分割
keybind = ctrl+space>s=new_split:down

# 垂直分割
keybind = ctrl+space>v=new_split:right

# 新しいウィンドウ
keybind = ctrl+space>t=new_window
