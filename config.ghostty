# 背景
background = #111111

# フォントサイズ
font-size = 14

# ANSI
palette = 1=#CC0000
palette = 2=#00A600

# 分割線
split-divider-color = #444444


# ========================================
# Leader
# ========================================

keybind = ctrl+space=activate_key_table:leader

# Leader解除
keybind = leader/escape=deactivate_key_table
keybind = leader/enter=deactivate_key_table


# ========================================
# ペイン移動
# ========================================

keybind = leader/h=goto_split:left
keybind = leader/j=goto_split:down
keybind = leader/k=goto_split:up
keybind = leader/l=goto_split:right


# ========================================
# タブ移動
# ========================================

keybind = leader/shift+h=previous_tab
keybind = leader/shift+l=next_tab


# ========================================
# ペイン・タブ操作
# ========================================

# 閉じる
keybind = leader/w=close_surface

# 水平分割
keybind = leader/s=new_split:down

# 垂直分割
keybind = leader/v=new_split:right

# 新しいウィンドウ
keybind = leader/t=new_window

